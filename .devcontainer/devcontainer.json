{
  "build": {
    "context": "..",
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "runArgs": [
    "--security-opt=label=disable",
    "--privileged",
    "--device=/dev/fuse"
  ],
  "postCreateCommand": "scripts/setup",
  "forwardPorts": [
    22111,
    22112
  ]
}
